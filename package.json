{
  "name": "logcat-json-formatter",
  "displayName": "Logcat JSON Formatter",
  "description": "格式化 Android Studio 中 Logcat 输出的 JSON 日志",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/wavky/Logcat-JSON-Formatter.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:log-formatter.formatLog"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "log-formatter.formatLog",
        "title": "Format Logcat JSON"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "echo 'No compilation needed'"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.80.0"
  }
}
